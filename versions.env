# Single source of version truth for the build pipeline. Sourced by scripts/*.sh
# and the workflows, and published in each release as version.json. The
# "# renovate:" lines let Renovate bump each pin together with its commit.

# ungoogled-chromium base. UC_COMMIT pins the tag's commit, so a moved tag fails
# the build instead of silently building different source. The Chromium version
# is derived, so a bump moves one value.
# renovate: datasource=github-tags depName=ungoogled-software/ungoogled-chromium
UC_TAG=156.0.8078.79-1
UC_COMMIT=28a211ab4ab6b83d919966a4f58a6df23cf4fb29
CHROMIUM_VERSION=${UC_TAG%-*}

# The source tarball (chromium-linux-tarballs; Google does not publish one for
# every release). Pinned because its .hashes file comes from the same release.
# Set by scripts/update-tarball-pin.sh whenever UC_TAG moves.
CHROMIUM_TARBALL_SHA256=362f7f0f21e69431540757b69044c4581146f23c9afec8e6b0a6abe1037bd351

# The stealth patch series: patches/stealth is cuttle's packages/browser/patches
# at this release, synced by scripts/sync-stealth-patches.sh.
# renovate: datasource=github-tags depName=glim-sh/cuttle
CUTTLE_TAG=browser-v156.0.8078.47-1
CUTTLE_COMMIT=234f010f377575324b1611710b618fd1aa26a0d6

# depot_tools provides the cipd client that fetches Chromium's pinned tools.
# renovate: datasource=git-refs depName=https://chromium.googlesource.com/chromium/tools/depot_tools.git
DEPOT_TOOLS_BRANCH=main
DEPOT_TOOLS_COMMIT=a20039648c0de69d8156906b18052bd47e9bf230

# Where the other vendored files came from (provenance only):
#   scripts/deps.py, docker/build.Dockerfile, flags.gn <- glim-sh/cuttle
#   .github/workflows/build.yml, .github/actions/build, .github/scripts
#     <- ungoogled-software/ungoogled-chromium-portablelinux
PORTABLELINUX_COMMIT=56b2567742c0423e8e70fd5da286f0762605d26c
