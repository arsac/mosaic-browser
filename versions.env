# Version pins for the build pipeline. Sourced by scripts/*.sh and the
# workflows, and published in each release as version.json. The "# renovate:"
# lines let Renovate bump each pin together with its commit.

# ungoogled-chromium base. The stealth series is cut for one ungoogled release,
# so the two move together or not at all: the series' own pin derives this one
# rather than a second rule moving them apart. UC_COMMIT pins the tag's commit,
# so a moved tag fails the build instead of silently building different source.
UC_TAG=156.0.8078.47-1
UC_COMMIT=0673f8701c94e5688c33ef8ce5e36602d311d246
CHROMIUM_VERSION=${UC_TAG%-*}

# The source tarball (chromium-linux-tarballs; Google does not publish one for
# every release). Pinned because its .hashes file comes from the same release.
# Updated with UC_TAG, never by hand.
CHROMIUM_TARBALL_SHA256=4a289892051e1e2737cdd9c9497ec1e2a01cdcdeca7ac060c6b6993c8606b8f2

# depot_tools provides the cipd client that fetches Chromium's pinned tools.
# renovate: datasource=git-refs depName=https://chromium.googlesource.com/chromium/tools/depot_tools.git
DEPOT_TOOLS_BRANCH=main
DEPOT_TOOLS_COMMIT=2960e876ad78502c616e27e1a89b9e01ca77ca7e

# Where the portablelinux-derived CI files came from; stamped into version.json.
PORTABLELINUX_COMMIT=56b2567742c0423e8e70fd5da286f0762605d26c
