# Appended to ungoogled-chromium's flags.gn (minus the keys set again here) to
# form args.gn. This is cuttle's x64 configuration (build-linux.sh stage 6),
# kept identical so the binary matches the one the stealth series is validated
# on; only its compiler-cache flags are left out, which do not change codegen.
is_debug = false
is_official_build = true
use_thin_lto = false
thin_lto_enable_optimizations = false
is_cfi = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
enable_nacl = false
enable_remoting = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
# Widevine key-system support only: no CDM is bundled or fetched.
enable_widevine = true
treat_warnings_as_errors = false
target_cpu = "x64"
use_sysroot = false
safe_browsing_mode = 0
chrome_pgo_phase = 0
